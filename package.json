{
	"name": "weft",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"start": "pnpm build && sh scripts/start.sh",
		"build": "vite build",
		"format": "biome check . --write --vcs-enabled=true --vcs-client-kind=git --vcs-use-ignore-file=true",
		"format:check": "biome check . --vcs-enabled=true --vcs-client-kind=git --vcs-use-ignore-file=true",
		"typecheck": "tsc --noEmit",
		"test": "pnpm build && node --test test/*.test.ts",
		"test:e2e": "pnpm build && playwright test && node -e \"require('node:fs').rmSync('test-results', { recursive: true, force: true })\""
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.2",
		"@playwright/test": "^1.64.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.3.5"
	},
	"packageManager": "pnpm@11.28.8+sha512.f6988a32046b9a3f78d7d7ee0747926bbe905ff9dff73bf19abb87bd7d1906a2ac90d93f73be32b5f9e14c2899569bcb0c9c5ec8a19e083f5d71bbab6dd9e0b8",
	"dependencies": {
		"@modelcontextprotocol/client": "2.3.1",
		"@openai/codex": "0.164.0",
		"i18next": "^26.5.6",
		"isbinaryfile": "^6.0.0",
		"playwright": "1.64.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-i18next": "^17.1.4",
		"react-markdown": "^10.1.0",
		"remark-gfm": "^4.0.1",
		"yaml": "^2.9.1"
	}
}
